# Copy to `.env` and fill in the passwords. Docker Compose and OrgOS both read
# `.env`; it is gitignored. Connection strings are built from these parts in
# `orgos.config`, so each password is written once. Empty values count as unset.

# --- Postgres (SQL store) ---
# Container superuser, used only by the bootstrap.
POSTGRES_PASSWORD=
# orgos_owner: loads and dbt.
ORGOS_PG_OWNER_PASSWORD=
# orgos_reader: the agent, SELECT on `model` only.
ORGOS_PG_READER_PASSWORD=
ORGOS_PG_HOST=127.0.0.1
# Change this if 5432 is already taken on your machine.
ORGOS_PG_PORT=5432

# --- MongoDB (staging store) ---
MONGO_INITDB_ROOT_USERNAME=orgos
MONGO_INITDB_ROOT_PASSWORD=
ORGOS_MONGO_HOST=127.0.0.1
ORGOS_MONGO_PORT=27017

# --- Neo4j (graph store) ---
# neo4j/<password>, the password at least 8 characters.
NEO4J_AUTH=
ORGOS_NEO4J_HOST=127.0.0.1
ORGOS_NEO4J_BOLT_PORT=7687
ORGOS_NEO4J_HTTP_PORT=7474
# Keep this as neo4j. A graph load clears it only while it loads.
ORGOS_NEO4J_READ_ONLY_DATABASES=neo4j

# --- Query agent (the query agent spec sets these) ---
# For example anthropic:<dated model id>, never a "latest" alias.
ORGOS_MODEL=
ORGOS_AGENT_REQUEST_LIMIT=
ORGOS_AGENT_TOKEN_LIMIT=
ORGOS_AGENT_TOOL_CALL_LIMIT=
ORGOS_AGENT_MAX_ROWS=200
ORGOS_AGENT_TEMPERATURE=
ORGOS_AGENT_MAX_TOKENS=

# --- One timeout, in seconds, for both stores ---
ORGOS_QUERY_TIMEOUT_S=30

# --- Provider keys ---
ANTHROPIC_API_KEY=
# Only if that provider is used.
OPENAI_API_KEY=
