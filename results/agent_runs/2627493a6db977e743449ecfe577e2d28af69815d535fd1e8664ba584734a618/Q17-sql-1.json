      "text": "with pairs as (\nselect l.link_id, l.from_issue_key a, l.to_issue_key b from model.issue_link l\njoin model.issue i1 on i1.issue_key=l.from_issue_key join model.issue i2 on i2.issue_key=l.to_issue_key\nwhere i1.project_key<>i2.project_key),\npp as (select distinct p.link_id, x.person_key, p.a, p.b from pairs p\njoin model.logged_time x on x.issue_key=p.a and x.seconds>0\njoin model.logged_time y on y.issue_key=p.b and y.seconds>0 and y.person_key=x.person_key),\npi as (select person_key, a as issue_key from pp union select person_key, b from pp)\nselect pi.person_key id, sum(t.seconds) value from pi join model.logged_time t on t.person_key=pi.person_key and t.issue_key=pi.issue_key and t.seconds>0 group by 1 order by 2 desc"
