      "text": "MATCH (p:Person)-[t:LOGGED_TIME]->(i:Issue)-[:IN_PROJECT]->(pr:Project)\nWHERE t.seconds>0 AND t.loggedAt>=datetime('2009-10-01T00:00:00Z') AND t.loggedAt<datetime('2010-01-01T00:00:00Z') AND (i.resolutionName IS NULL OR i.resolutionName='')\nWITH i.issueKey AS id, pr.projectKey AS project, sum(t.seconds) AS value, collect(t.historyId) AS entries\nORDER BY value DESC\nWITH collect({id:id,project:project,value:value,entries:entries}) AS rows\nWITH rows, rows[4].value AS cut\nUNWIND rows AS r\nWITH r WHERE size(rows)<5 OR r.value>=cut\nRETURN r.id AS id, r.project AS project, r.value AS value, r.entries AS entries"
