      "text": "MATCH (i:Issue)<-[l:LOGGED_TIME]-(p:Person) WHERE i.timeOriginalEstimateS>0 AND l.seconds>0\nWITH i, sum(l.seconds) AS tot, collect(l.historyId) AS tes, collect(DISTINCT p.personKey) AS ps\nWITH i, abs(i.timeOriginalEstimateS-tot) AS value, tes, ps\nORDER BY value DESC\nWITH collect({i:i.issueKey,v:value,t:tes,p:ps}) AS rows\nWITH rows, rows[CASE WHEN size(rows)>=10 THEN 9 ELSE size(rows)-1 END].v AS cut\nUNWIND rows AS r\nWITH r WHERE r.v>=cut\nRETURN r.i AS id, r.v AS value, r.t AS tes, r.p AS ps\nORDER BY value DESC"
    },
